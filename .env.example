# All values are optional here — the server can also read them from
# ~/.collaborai/secrets.json (Slack tokens are prompted by a wizard on first
# `server --slack` launch). Env vars take precedence over the secrets file.

# Shared secret between server, daemons and CLI clients
WS_AUTH_TOKEN=change-me

# Server
WS_PORT=8080
# Slack mode only (server --slack):
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Daemon (each dev)
SERVER_URL=ws://localhost:8080
# Optional explicit identity; falls back to hostname if unset
DAEMON_ID=alice

# CLI client (each dev) — usually configured via `collaborai login` instead
# SERVER_URL=ws://your-server:8080
